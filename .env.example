# Set real values only in local .env.local or Vercel Environment Variables.
# Never expose them in browser variables, screenshots, chat logs, or Git.
DEEPSEEK_API_KEY=replace_with_a_new_rotated_key
DEEPSEEK_MODEL=deepseek-flash

# Developer-only: use a separate long random string, never the DeepSeek key.
ADMIN_API_TOKEN=replace_with_a_separate_random_token
DEEPSEEK_LOW_BALANCE_CNY=10
